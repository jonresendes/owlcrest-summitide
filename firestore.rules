rules_version = '2';
// Summitide Learning (formerly The Academy · LearnHub) — security rules, v75 (free-plan edition: no Cloud Functions).
// v75 adds: classBanners (the picture across the top of a class).
// v68 adds: only the Headmaster can delete a student from the school (a teacher takes a student out of a class instead);
// the names of each teacher's classes for the Staff page (staffClasses, staff only); the Curriculum shelf (curriculum,
// curriculumChunks: staff read, the Headmaster writes); and the head of the school's title on settings/global, which only the Headmaster may change.
// v66 adds: sign-in codes (signin), holds, corrections, the longer policy record, and two refusals:
// nothing of a student on hold can be deleted, and a device holding an old copy cannot write over a record that was cleaned up.
// Paste the whole file into Firebase console → Firestore Database → Rules → Publish.
//
// The idea in one paragraph: being signed in is not enough. A caller must have a staff record or a
// student record to read anything. A student reads and writes only their own records. A teacher
// reads and writes only students whose access list (`teachers`, on the student's record) holds the
// teacher's id — a teacher can put themselves on that list (that is what adding a student to a
// section does) and take themselves off, but can never touch anyone else's entry. Grades sit in
// their own records, which a student can read and never write. The Headmaster (the account named
// in meta/master) can do everything.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isStaff() { return signedIn() && exists(/databases/$(database)/documents/staff/$(request.auth.uid)); }
    function isStudent() { return signedIn() && exists(/databases/$(database)/documents/students/$(request.auth.uid)); }
    function known() { return isStaff() || isStudent(); }
    function isMaster() { return signedIn() && exists(/databases/$(database)/documents/meta/master) && get(/databases/$(database)/documents/meta/master).data.uid == request.auth.uid; }
    function noMasterYet() { return !exists(/databases/$(database)/documents/meta/master); }
    // May the caller manage this student? The Headmaster, or a teacher on the student's access list.
    function teaches(sid) { return isMaster() || (isStaff() && request.auth.uid in get(/databases/$(database)/documents/students/$(sid)).data.teachers); }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    // v66 · HOLDS. A hold on one student (holds/<student>) or on the whole school (settings/policy.holdAll) means
    // nothing of theirs may be deleted by anyone, the Headmaster included, until the Headmaster lifts it.
    function schoolHold() { return exists(/databases/$(database)/documents/settings/policy) && 'holdAll' in get(/databases/$(database)/documents/settings/policy).data && get(/databases/$(database)/documents/settings/policy).data.holdAll == true; }
    function held(sid) { return schoolHold() || exists(/databases/$(database)/documents/holds/$(sid)); }
    // v66 · A record emptied by the end-of-term clean-up carries purged: true and the time. A later write must be newer than that:
    // a device that was offline (or kept signed in) with the old work cannot put it back.
    function isPurged(d) { return 'purged' in d && d.purged == true; }
    function notStale() { return !isPurged(resource.data) || (request.resource.data.updatedAt is string && request.resource.data.updatedAt > resource.data.updatedAt); }
    // ... and the clean-up itself (purged: true) is refused while the student is on hold.
    function notPurgingHeld(sid) { return !isPurged(request.resource.data) || !held(sid); }

    // ----- who is the Headmaster -----
    match /meta/master {
      allow read: if known();
      // create: first-time set-up only
      allow create: if signedIn() && noMasterYet() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isMaster();
    }
    // Which data version the project is on (written by the Headmaster's app after the one-time upgrade).
    match /meta/config {
      allow read: if known();
      allow write: if isMaster();
    }
    // Which sign-in a teacher ID uses now (after a password reset). The sign-in screen looks one ID up
    // before anyone is signed in.
    match /logins/{login} {
      allow get: if true;
      allow list, write: if isMaster();
    }

    // ----- staff -----
    // The public part of a staff record (name, picture, teacher ID). Students see it for their teachers' names.
    match /staff/{sid} {
      allow read: if known();
      allow create: if isMaster() || (signedIn() && request.auth.uid == sid && noMasterYet());
      allow update: if isMaster() || (isStaff() && request.auth.uid == sid && !changed().hasAny(['id', 'role', 'login']));
      allow delete: if isMaster();
    }
    // A teacher's sticky notes: that teacher. (The Headmaster's app moves them when it resets that teacher's password.)
    match /staffNotes/{sid} {
      allow read, write: if isMaster() || (isStaff() && request.auth.uid == sid);
    }
    // A teacher's e-mail address: that teacher and the Headmaster.
    match /staffPrivate/{sid} {
      allow read, write: if isMaster() || (isStaff() && request.auth.uid == sid);
    }

    // ----- students -----
    // What a student may change about themselves (notes = their own sticky notes). Never the level, course list, accommodations, track, name or number.
    function studentOwnFields() {
      // v60: coins = coins the student's own app has counted from their work; coinReq = what they have asked a shop for
      return ['prefs', 'archived', 'suggestions', 'lessonLevels', 'levelLog', 'courseLevels', 'avatar', 'colour', 'notes', 'coins', 'coinReq', 'rev', 'updatedAt', 'updatedBy'];
    }
    // A picture is one emoji and a colour is a colour — never markup.
    function tidyOwnFields() {
      return (!changed().hasAny(['avatar']) || (request.resource.data.avatar is string && request.resource.data.avatar.size() <= 16 && !request.resource.data.avatar.matches('(?s).*[<>].*')))
          && (!changed().hasAny(['colour']) || (request.resource.data.colour is string && request.resource.data.colour.matches('^#[0-9a-fA-F]{3,8}$')))
          && (!changed().hasAny(['coinReq']) || (request.resource.data.coinReq is list && request.resource.data.coinReq.size() <= 10))
          && (!changed().hasAny(['coins']) || request.resource.data.coins is map);
    }
    // The access list may change only by the caller's own id being added or taken away.
    function onlyOwnEntryChanges() {
      return request.resource.data.teachers is list
          && request.resource.data.teachers.removeAll([request.auth.uid]) == resource.data.teachers.removeAll([request.auth.uid]);
    }
    // Self sign-up, only while the school's switch is saved as on: a plain profile with nothing granted.
    function selfSignupOpen() { return get(/databases/$(database)/documents/settings/global).data.allowSelfSignup == true; }
    function plainNewProfile() {
      return request.resource.data.keys().hasOnly(['id', 'name', 'createdAt', 'avatar', 'colour', 'level', 'courseLevels', 'courses', 'coursesLocked', 'accommodations', 'prefs', 'suggestions', 'track', 'archived', 'levelLog', 'lessonLevels', 'number', 'teachers', 'updatedAt', 'updatedBy', 'rev'])   // v66: no birthday
          && request.resource.data.name is string && request.resource.data.name.size() <= 40 && !request.resource.data.name.matches('(?s).*[<>].*')
          && request.resource.data.number is string && request.resource.data.number.size() <= 40
          && request.resource.data.avatar is string && request.resource.data.avatar.size() <= 16 && !request.resource.data.avatar.matches('(?s).*[<>].*')
          && request.resource.data.level == 2
          && request.resource.data.courses is list && request.resource.data.courses.size() == 0
          && request.resource.data.teachers is list && request.resource.data.teachers.size() == 0
          && request.resource.data.track.size() == 0 && request.resource.data.courseLevels.size() == 0
          && request.resource.data.coursesLocked == false
          && request.resource.data.accommodations.size() == 3 && request.resource.data.accommodations['reduce'] == false && request.resource.data.accommodations['simplify'] == false && request.resource.data.accommodations['chunk'] == false;
    }
    match /students/{sid} {
      allow get: if signedIn() && (request.auth.uid == sid || isMaster() || (isStaff() && request.auth.uid in resource.data.teachers));
      allow list: if signedIn() && (isMaster() || (isStaff() && request.auth.uid in resource.data.teachers));
      // A teacher adds a student (and is the only one on the new access list), or a student signs themselves up.
      allow create: if signedIn() && request.resource.data.teachers is list && (
                       isMaster()
                    || (isStaff() && request.resource.data.teachers == [request.auth.uid])
                    || (request.auth.uid == sid && selfSignupOpen() && plainNewProfile()));
      // The Headmaster: anything.
      // A teacher who has this student: anything but the id and number; of the access list, only their own entry.
      // A teacher who does not have this student yet: may add themselves and nothing else.
      // The student: their own fields.
      allow update: if signedIn() && (
                       (isMaster() && request.resource.data.teachers is list)
                    || (isStaff() && request.auth.uid in resource.data.teachers && onlyOwnEntryChanges() && !changed().hasAny(['id', 'number']))
                    || (isStaff() && changed().hasOnly(['teachers']) && onlyOwnEntryChanges())
                    || (request.auth.uid == sid && changed().hasOnly(studentOwnFields()) && tidyOwnFields()));
      // v68: only the Headmaster deletes a student from the school. A teacher takes a student out of a class (the class roster and their own entry on the access list).
      // The one exception: a teacher's app may undo a student it has just created when the sign-in code could not be saved (no signin record exists).
      allow delete: if signedIn() && !held(sid) && (isMaster()
                    || (isStaff() && resource.data.teachers == [request.auth.uid] && !exists(/databases/$(database)/documents/signin/$(sid))));
    }
    // Name, number and picture of every student, so a teacher can add an existing student to a section. Staff only.
    match /directory/{sid} {
      allow read: if isStaff();
      // a student who signs themselves up leaves a card so a teacher can find them
      allow create: if signedIn() && (request.auth.uid == sid || teaches(sid));
      allow update, delete: if signedIn() && teaches(sid);
    }

    // ----- sections -----
    // A teacher sees and changes their own sections; a student sees the sections they are in.
    match /sections/{id} {
      allow read: if signedIn() && (isMaster() || (isStaff() && resource.data.teacherId == request.auth.uid) || request.auth.uid in resource.data.students);
      allow create: if isMaster() || (isStaff() && request.resource.data.teacherId == request.auth.uid);
      allow update: if isMaster() || (isStaff() && resource.data.teacherId == request.auth.uid && request.resource.data.teacherId == request.auth.uid);
      allow delete: if isMaster() || (isStaff() && resource.data.teacherId == request.auth.uid);
    }

    // ----- the picture across the top of a class (v75) -----
    // classBanners/<class id>: one small image as a data: address. Read by the people who can read the class (its teacher,
    // the Headmaster, its students); written by the class's teacher or the Headmaster. Kept apart from the class record so that
    // record stays small.
    match /classBanners/{cid} {
      function bannerClass() { return get(/databases/$(database)/documents/sections/$(cid)).data; }
      allow read: if signedIn() && (isMaster() || (isStaff() && bannerClass().teacherId == request.auth.uid) || request.auth.uid in bannerClass().students);
      allow create, update: if (isMaster() || (isStaff() && bannerClass().teacherId == request.auth.uid))
                    && request.resource.data.keys().hasOnly(['id', 'data', 'by', 'at']) && request.resource.data.id == cid
                    && request.resource.data.data is string && request.resource.data.data.size() <= 400000
                    && request.resource.data.data[0:11] == 'data:image/';
      allow delete: if isMaster() || (isStaff() && bannerClass().teacherId == request.auth.uid);
    }

    // ----- a student's work (slides read, quiz and test results, assignment text, awards) -----
    // One record per student and course, named <student>__<course>. The owner and their teachers.
    match /progress/{pid} {
      // asking for a record that does not exist reveals nothing
      allow get: if isStaff() && resource == null;
      allow read: if signedIn() && (isMaster() || resource.data.student == request.auth.uid || teaches(resource.data.student));
      // v59: the owner must still have a student record — a sign-in left over from a removed student can write nothing back
      allow create: if signedIn() && pid == request.resource.data.student + '__' + request.resource.data.course
                    && ((request.resource.data.student == request.auth.uid && isStudent()) || teaches(request.resource.data.student));
      allow update: if signedIn() && request.resource.data.student == resource.data.student && request.resource.data.course == resource.data.course
                    && ((resource.data.student == request.auth.uid && isStudent() && notStale() && !isPurged(request.resource.data))
                        || (teaches(resource.data.student) && notPurgingHeld(resource.data.student)));
      allow delete: if signedIn() && teaches(resource.data.student) && !held(resource.data.student);
    }
    // ----- teacher grades and comments -----
    // Kept apart from the student's work so that a student can read them but never write them.
    match /grades/{gid} {
      allow get: if isStaff() && resource == null;
      allow read: if signedIn() && (isMaster() || resource.data.student == request.auth.uid || teaches(resource.data.student));
      allow create: if signedIn() && gid == request.resource.data.student + '__' + request.resource.data.course && teaches(request.resource.data.student);
      allow update: if signedIn() && request.resource.data.student == resource.data.student && request.resource.data.course == resource.data.course && teaches(resource.data.student) && notPurgingHeld(resource.data.student);
      allow delete: if signedIn() && teaches(resource.data.student) && !held(resource.data.student);
    }
    // ----- Focus Plans -----
    match /focus/{sid} {
      allow read: if signedIn() && (request.auth.uid == sid || teaches(sid));
      allow create, update: if signedIn() && teaches(sid);
      allow delete: if signedIn() && teaches(sid) && !held(sid);
    }

    // ----- Live Class Board (v58) -----
    // live/<sectionId>: one running (or last) session per section — what the class is writing, Focus Mode,
    // who the teacher marked as writing. Written by that section's teacher (or the Headmaster); read by the
    // teacher and by the students on the section's roster.
    match /live/{sid} {
      allow read: if signedIn() && (isMaster()
                    || (isStaff() && resource.data.teacherId == request.auth.uid)
                    || (isStudent() && exists(/databases/$(database)/documents/sections/$(sid)) && request.auth.uid in get(/databases/$(database)/documents/sections/$(sid)).data.students));
      allow create, update: if isMaster()
                    || (isStaff() && request.resource.data.teacherId == request.auth.uid
                        && get(/databases/$(database)/documents/sections/$(sid)).data.teacherId == request.auth.uid);
      allow delete: if (isMaster() || (isStaff() && resource.data.teacherId == request.auth.uid)) && !schoolHold();
    }
    // presence/<uid>: where one student is inside Summitide right now, sent only while a session runs.
    // Written only by that student, in a fixed shape and size; read by the student's own teachers.
    // It never holds what the student typed or anything from outside the app.
    match /presence/{sid} {
      allow read: if signedIn() && (request.auth.uid == sid || teaches(sid));
      allow create, update: if isStudent() && request.auth.uid == sid
                    && request.resource.data.keys().hasOnly(['v', 'student', 'live', 'since', 'page', 'label', 'target', 'q', 'n', 'state', 'done', 'at', 'joinedAt', 'leaveCount', 'awaySecs', 'leaves', 'why'])
                    && request.resource.data.student == sid
                    && request.resource.data.page is string && request.resource.data.page.size() <= 200
                    && request.resource.data.label is string && request.resource.data.label.size() <= 120 && !request.resource.data.label.matches('(?s).*[<>].*')
                    && request.resource.data.state in ['on', 'blur', 'hidden']
                    && request.resource.data.leaves is list && request.resource.data.leaves.size() <= 20;
      allow delete: if signedIn() && (request.auth.uid == sid || teaches(sid)) && !held(sid);
    }

    // ----- "Found a problem?" reports -----
    // Anyone with a profile may send one under their own account, in the expected shape and size;
    // only the Headmaster can read, resolve or delete them.
    match /issues/{id} {
      allow create: if known() && request.resource.data.by == request.auth.uid
                    && request.resource.data.keys().hasOnly(['id', 'by', 'name', 'role', 'number', 'page', 'title', 'text', 'shot', 'at', 'status', 'version', 'screen', 'agent'])
                    && request.resource.data.text is string && request.resource.data.text.size() <= 2000
                    && request.resource.data.shot is string && request.resource.data.shot.size() <= 750000
                    && (request.resource.data.shot == '' || request.resource.data.shot.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]*$'))
                    && request.resource.data.status == 'open';
      allow read, update: if isMaster();
      allow delete: if isMaster() && !held(resource.data.by);
    }

    // ----- courses loaded from a file by the Headmaster -----
    // Anyone with a record reads them (students need the course to study it); only the Headmaster writes.
    match /courses/{code} {
      allow read: if isStaff() || isStudent();
      allow write: if isMaster();
    }
    match /courseChunks/{part} {
      allow read: if isStaff() || isStudent();
      allow write: if isMaster();
    }

    // ----- shared options -----
    // Not secret (two switches). The sign-in screen reads it before anyone is signed in, to know whether to offer "I'm new".
    match /settings/global {
      allow read: if true;
      // v68: headTitle (what the school calls its head) is the Headmaster's to set; a teacher's write must leave it as it is.
      allow create: if isMaster() || (isStaff() && !('headTitle' in request.resource.data));
      allow update: if isMaster() || (isStaff() && !changed().hasAny(['headTitle']));
      allow delete: if isMaster();
    }

    // ----- the Staff page (v68) -----
    // staffClasses/<staff id>: the names, course codes and terms of the classes a teacher has now. No rosters and no students.
    // Staff read them; a teacher writes their own; the Headmaster writes anyone's. Students cannot read them.
    match /staffClasses/{tid} {
      allow read: if isStaff();
      allow create, update: if (isMaster() || (isStaff() && request.auth.uid == tid))
                    && request.resource.data.keys().hasOnly(['id', 'classes', 'updatedAt'])
                    && request.resource.data.id == tid && request.resource.data.classes is list && request.resource.data.classes.size() <= 30;
      allow delete: if isMaster();
    }

    // ----- the Curriculum shelf (v68) -----
    // Published documents (Ministry curriculum, policy documents, course outlines): a link, or a PDF kept in pieces.
    // Nothing about a person. Staff read; only the Headmaster adds or removes.
    match /curriculum/{id} {
      allow read: if isStaff();
      allow create, update: if isMaster()
                    && request.resource.data.keys().hasOnly(['id', 'title', 'course', 'province', 'kind', 'year', 'note', 'link', 'file', 'addedBy', 'addedAt'])
                    && plainLine(request.resource.data.title, 140) && plainLine(request.resource.data.link, 400);
      allow delete: if isMaster();
    }
    match /curriculumChunks/{part} {
      allow read: if isStaff();
      allow create, update: if isMaster() && request.resource.data.keys().hasOnly(['doc', 'n', 'data'])
                    && request.resource.data.data is string && request.resource.data.data.size() <= 800000;
      allow delete: if isMaster();
    }

    // ----- coins, shops and lockers (v60) -----
    // coins/<student>: the ledger — coins spent, given and refunded, and the items in the student's locker.
    // Only the student's teachers (and the Headmaster) write it; the student reads it and can never change it.
    match /coins/{sid} {
      allow read: if signedIn() && (request.auth.uid == sid || teaches(sid));
      allow create, update: if signedIn() && teaches(sid) && request.resource.data.student == sid && request.resource.data.entries is list;
      allow delete: if signedIn() && teaches(sid) && !held(sid);
    }
    // shops/<staff id>: a teacher's shop. Anyone with a record may look; only its owner (or the Headmaster) changes it.
    match /shops/{tid} {
      allow read: if known();
      allow create, update: if (isMaster() || (isStaff() && request.auth.uid == tid)) && request.resource.data.owner == tid && request.resource.data.items is list && request.resource.data.items.size() <= 40;
      allow delete: if isMaster() || (isStaff() && request.auth.uid == tid);
    }
    // The Headmaster's switch for the whole school. Not secret.
    match /settings/coins {
      allow read: if true;
      allow write: if isMaster();
    }

    // ----- the school's privacy and retention policy (v59, longer in v66) -----
    // Not secret: the privacy notice is open to anyone, signed in or not, and reads its words and periods from here.
    // Only the Headmaster writes it, in a fixed shape: switches, lines of plain text and three periods in days.
    function plainLine(v, max) { return v is string && v.size() <= max && !v.matches('(?s).*[<>].*'); }
    match /settings/policy {
      allow read: if true;
      allow create, update: if isMaster()
                    && request.resource.data.keys().hasOnly(['pv', 'allowDictation', 'boardReviewed', 'contact', 'authority', 'officerTitle', 'officerAddress', 'officerPhone', 'autoSweep', 'holdAll', 'allowDrive', 'allowEmbeds', 'allowOutsideMedia', 'shotDays', 'reportDays', 'liveDays', 'updatedAt', 'updatedBy'])
                    && request.resource.data.pv == 2
                    && request.resource.data.allowDictation is bool && request.resource.data.boardReviewed is bool
                    && request.resource.data.autoSweep is bool && request.resource.data.holdAll is bool
                    && request.resource.data.allowDrive is bool && request.resource.data.allowEmbeds is bool && request.resource.data.allowOutsideMedia is bool
                    && plainLine(request.resource.data.contact, 200) && plainLine(request.resource.data.authority, 400)
                    && plainLine(request.resource.data.officerTitle, 120) && plainLine(request.resource.data.officerAddress, 240) && plainLine(request.resource.data.officerPhone, 40)
                    && request.resource.data.shotDays is int && request.resource.data.shotDays >= 1 && request.resource.data.shotDays <= 3650
                    && request.resource.data.reportDays is int && request.resource.data.reportDays >= 7 && request.resource.data.reportDays <= 3650
                    && request.resource.data.liveDays is int && request.resource.data.liveDays >= 1 && request.resource.data.liveDays <= 3650;
      allow delete: if false;
    }

    // ----- sign-in codes (v66) -----
    // signin/<student>: the student's current sign-in code. A browser can only replace a password it knows, so the
    // code is kept here for the student's teachers and the Headmaster, and for nobody else: the student cannot read it.
    // A student who signs themselves up (only while the school allows it) writes their own once, before their profile exists.
    function codeRecord(sid) {
      return request.resource.data.keys().hasOnly(['student', 'code', 'issuedAt', 'issuedBy'])
          && request.resource.data.student == sid
          && request.resource.data.code is string && request.resource.data.code.size() >= 8 && request.resource.data.code.size() <= 80 && request.resource.data.code.matches('^[a-z0-9-]+$');
    }
    match /signin/{sid} {
      allow get: if signedIn() && teaches(sid);
      allow list: if isMaster();
      allow create: if signedIn() && codeRecord(sid)
                    && (teaches(sid) || (request.auth.uid == sid && selfSignupOpen() && !exists(/databases/$(database)/documents/students/$(sid))));
      allow update: if signedIn() && codeRecord(sid) && teaches(sid);
      allow delete: if signedIn() && (teaches(sid) || (request.auth.uid == sid && !exists(/databases/$(database)/documents/students/$(sid))));
    }

    // ----- holds (v66) -----
    // holds/<student>: placed and lifted only by the Headmaster; the student's teachers can see that one exists.
    // While it exists the delete rules above refuse (see held()).
    match /holds/{sid} {
      allow get: if signedIn() && teaches(sid);
      allow list: if isMaster();
      allow create, update: if isMaster()
                    && request.resource.data.keys().hasOnly(['student', 'reason', 'at', 'by', 'byName'])
                    && request.resource.data.student == sid && plainLine(request.resource.data.reason, 200);
      allow delete: if isMaster();
    }

    // ----- corrections (v66) -----
    // correctionRequests/<student>: what the student has asked to have corrected. Their own record: they write it, their teachers read it.
    // corrections/<student>: what the school did about it — corrected, not corrected (with the reason), statements of
    // disagreement. Written by the student's teachers, never shorter than before; the student reads it and cannot change it.
    match /correctionRequests/{sid} {
      allow get: if signedIn() && (request.auth.uid == sid || teaches(sid));
      allow list: if isMaster();
      allow create, update: if isStudent() && request.auth.uid == sid
                    && request.resource.data.keys().hasOnly(['student', 'items', 'updatedAt'])
                    && request.resource.data.student == sid && request.resource.data.items is list && request.resource.data.items.size() <= 30;
      allow delete: if signedIn() && teaches(sid) && !held(sid);
    }
    match /corrections/{sid} {
      allow get: if signedIn() && (request.auth.uid == sid || teaches(sid));
      allow list: if isMaster();
      allow create: if signedIn() && teaches(sid) && request.resource.data.student == sid && request.resource.data.items is list && request.resource.data.items.size() <= 300;
      allow update: if signedIn() && teaches(sid) && request.resource.data.student == sid && request.resource.data.items is list
                    && request.resource.data.items.size() <= 300 && request.resource.data.items.size() >= resource.data.items.size();
      allow delete: if isMaster() && !held(sid);
    }

    // ----- change log -----
    // Staff apps add a line when they create, remove or take on a student, change an account, give out a sign-in code,
    // place or lift a hold, record a correction, or print or download records (v66).
    // Lines cannot be edited or removed by anyone; only the Headmaster can read them.
    match /audit/{id} {
      allow create: if isStaff() && request.resource.data.by == request.auth.uid;
      allow read: if isMaster();
      allow update, delete: if false;
    }
  }
}
